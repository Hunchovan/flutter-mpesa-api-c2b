# M-Pesa API Configuration
# Copy this file to .env and fill in your credentials
# IMPORTANTE: Este arquivo é um exemplo! Crie um arquivo .env com suas credenciais reais

# Your M-Pesa API Key
# Sua chave de API do M-Pesa
MPESA_API_KEY=your_api_key_here

# Your M-Pesa Public Key (RSA public key)
# Sua chave pública M-Pesa
MPESA_PUBLIC_KEY=your_public_key_here

# Your Service Provider Code
# Seu código de provedor de serviço
MPESA_SERVICE_PROVIDER_CODE=your_service_provider_code_here

# M-Pesa API Base URL (Sandbox for testing, change for production)
# URL base da API M-Pesa (Sandbox para testes, mude para produção)
MPESA_BASE_URL=https://api.sandbox.vm.co.mz:18352
